{
  "manifest_version": 3,
  "name": "ZeroVault - Password Manager",
  "version": "1.0.0",
  "description": "Zero-Knowledge client-side encrypted password manager with 1-click autofill and autosave.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ZeroVault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://pradip-vault.pages.dev/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://pradip-vault.pages.dev/*"
      ],
      "js": [
        "content/vault-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://pradip-vault.pages.dev/*"
      ],
      "js": [
        "content/autofill.js"
      ],
      "css": [
        "content/autofill.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg",
        "icons/icon-32.png",
        "icons/icon-48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
